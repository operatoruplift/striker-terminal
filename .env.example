# Striker Terminal configuration. Every variable is optional: with none set, the
# terminal runs in demo mode with mock markets, a simulated wallet and no RPC calls.
#
# Copy to .env.local and uncomment only the lines you need. Keep unused lines
# commented out: an empty NEXT_PUBLIC_RPC_ENDPOINT= is not the same as unset and
# stops the terminal from loading.

# Set to false for live mode: a real Phantom wallet and devnet transactions.
# NEXT_PUBLIC_USE_MOCKS=

# Solana RPC endpoint for the wallet, balances and transactions. Unset uses devnet.
# NEXT_PUBLIC_RPC_ENDPOINT=

# USDG SPL mint. When set, the USDG balance is read from the wallet's token account.
# NEXT_PUBLIC_USDG_MINT=

# Anchor program ids for the daily markets and the futures bracket, once deployed.
# NEXT_PUBLIC_PREDICTION_PROGRAM_ID=
# NEXT_PUBLIC_FUTURES_PROGRAM_ID=

# pay.sh delegate shown in the Season Pass authorization.
# NEXT_PUBLIC_PAYSH_DELEGATE=
